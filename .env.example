# Reference only. Generate actual local secrets with npm run dev:secrets.
# Never copy sample values to production. Do not commit .env or .local/.
APP_ENV=development
BIND=127.0.0.1:8080
ISSUER=http://localhost:5173
RP_ID=localhost
DATABASE_URL=
REDIS_URL=redis://localhost:6379
SIGNING_KEY_FILE=.local/signing.pem
SIGNING_KID=local-signing-1
JWKS_PREVIOUS_FILE=
ENCRYPTION_KEYS_FILE=.local/encryption-keys.json
ACTIVE_ENCRYPTION_KID=local-aead-1
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD_FILE=
SMTP_FROM=no-reply@localhost
# required verifies TLS certificates; disabled is restricted to development Mailpit.
SMTP_TLS=disabled
TRUSTED_PROXY_CIDRS=
DATABASE_POOL_MAX=32
ARGON2_PARALLELISM_LIMIT=4
BACKUP_DESTINATION=

# Separate A/B BFF instances; client secrets come from restricted files.
BFF_PUBLIC_ORIGIN=http://localhost:5174
BFF_CLIENT_ID=demo-a
BFF_NAMESPACE=demo_a
BFF_COOKIE_NAME=demo-a-session-dev
BFF_CLIENT_SECRET_FILE=.local/bff/demo-a-secret
# Only development Compose accepts the exact identity-web DNS override.
BFF_ISSUER_CONNECT_HOST=
