FROM docker.m.daocloud.io/library/node:22.22.1-bookworm-slim@sha256:4f77a690f2f8946ab16fe1e791a3ac0667ae1c3575c3e4d0d4589e9ed5bfaf3d AS frontend
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY apps/identity-web/package.json ./apps/identity-web/package.json
COPY apps/demo-a/package.json ./apps/demo-a/package.json
COPY apps/demo-b/package.json ./apps/demo-b/package.json
RUN --mount=type=cache,id=auth-rust-npm-cache,target=/root/.npm,sharing=locked npm ci
COPY apps ./apps
RUN npm run build --workspaces

FROM docker.m.daocloud.io/library/caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
RUN addgroup -g 10001 identity && adduser -u 10001 -G identity -D -H identity && \
    mkdir -p /data/caddy /config/caddy && chown -R 10001:10001 /data /config
COPY --from=frontend /workspace/apps/identity-web/dist /srv/identity
COPY --from=frontend /workspace/apps/demo-a/dist /srv/demo-a
COPY --from=frontend /workspace/apps/demo-b/dist /srv/demo-b
COPY infra/Caddyfile.prod /etc/caddy/Caddyfile
USER 10001:10001
EXPOSE 8080 8443
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
