# Host collector configuration; no credentials. Set after verifying actual mounted storage.
ISSUER=https://identity.example.test
OPS_DATA_DIRECTORY=/srv/identity/postgres
OPS_DATA_DEVICE=REPLACE_WITH_VERIFIED_STAT_DEVICE_NUMBER
OPS_BACKUP_DIRECTORY=/mnt/independent-backup/base
OPS_BACKUP_DEVICE=REPLACE_WITH_VERIFIED_STAT_DEVICE_NUMBER
OPS_METRICS_FILE=/var/lib/node_exporter/textfile_collector/identity-ops.prom
# Optional controlled enterprise/test CA bundle; omit to use the operating system trusted CAs.
# OPS_TLS_CA_FILE=/etc/identity/issuer-ca.pem
