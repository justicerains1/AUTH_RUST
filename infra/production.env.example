# Public release selection only. Real service/SMTP/database secrets go in ignored .local/production.
RUST_IMAGE=registry.example/auth-rust-runtime@sha256:REPLACE_WITH_REVIEWED_RELEASE_DIGEST
EDGE_IMAGE=registry.example/auth-rust-edge@sha256:REPLACE_WITH_REVIEWED_RELEASE_DIGEST
IDENTITY_HOST=identity.example
DEMO_A_HOST=app-a.example
DEMO_B_HOST=app-b.example
TLS_EMAIL=operations@example
# Absolute independent storage mount, prepared before Compose; never a local Docker data volume.
# Backup jobs use BACKUP_DESTINATION/base; PostgreSQL archives into BACKUP_DESTINATION/wal.
BACKUP_DESTINATION=/REPLACE_WITH_INDEPENDENT_BACKUP_MOUNT/identity
AGE_RECIPIENT=REPLACE_WITH_REVIEWED_AGE_PUBLIC_RECIPIENT
