{
	email {$TLS_EMAIL}
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	admin off
}

http://{$IDENTITY_HOST}:8080, http://{$DEMO_A_HOST}:8080, http://{$DEMO_B_HOST}:8080 {
	redir https://{host}{uri} permanent
}

(common_security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'"
		Cache-Control "no-store"
	}
	header -Server
}

{$IDENTITY_HOST} {
	import common_security
	@identity_api path /api/* /health/* /.well-known/openid-configuration /oauth/authorize /oauth/token /oauth/jwks /oauth/userinfo /oauth/introspect /oauth/revoke /oauth/logout /oauth/logout/confirm
	handle @identity_api {
		reverse_proxy api:8080
	}
	handle /assets/* {
		root * /srv/identity
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/identity
		try_files {path} /index.html
		file_server
	}
}

{$DEMO_A_HOST} {
	import common_security
	handle /bff/* {
		reverse_proxy demo-a-bff:8082
	}
	handle /health/* {
		reverse_proxy demo-a-bff:8082
	}
	handle /assets/* {
		root * /srv/demo-a
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/demo-a
		try_files {path} /index.html
		file_server
	}
}

{$DEMO_B_HOST} {
	import common_security
	handle /bff/* {
		reverse_proxy demo-b-bff:8083
	}
	handle /health/* {
		reverse_proxy demo-b-bff:8083
	}
	handle /assets/* {
		root * /srv/demo-b
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/demo-b
		try_files {path} /index.html
		file_server
	}
}
